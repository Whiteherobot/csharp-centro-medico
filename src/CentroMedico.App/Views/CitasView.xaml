<UserControl x:Class="CentroMedico.App.Views.CitasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="310"/>
        </Grid.ColumnDefinitions>

        <!--Agenda-->
        <Border Grid.Column="0" Style="{StaticResource tarjeta}" Margin="0,0,16,0">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Día" Style="{StaticResource etiqueta}" Margin="0,0,0,3"/>
                        <DatePicker SelectedDate="{Binding FechaAgenda}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Médico" Style="{StaticResource etiqueta}" Margin="0,0,0,3"/>
                        <ComboBox ItemsSource="{Binding FiltroMedicos}" DisplayMemberPath="Texto" SelectedValuePath="Valor"
                                  SelectedValue="{Binding MedicoFiltro}"/>
                    </StackPanel>
                </Grid>

                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="Atendida" Command="{Binding AtenderCommand}" Style="{StaticResource botonPrimario}"/>
                    <Button Content="No asistió" Command="{Binding NoAsistioCommand}" Style="{StaticResource botonSecundario}"/>
                    <Button Content="Cancelar cita" Command="{Binding CancelarCommand}" Style="{StaticResource botonSecundario}"/>
                </StackPanel>

                <TextBlock DockPanel.Dock="Top" Text="No hay citas para este día."
                           Style="{StaticResource textoSecundario}" Margin="0,0,0,8"
                           Visibility="{Binding AgendaVacia, Converter={StaticResource BooleanToVisibility}}"/>

                <DataGrid ItemsSource="{Binding Citas}" SelectedItem="{Binding CitaSeleccionada}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Hora" Binding="{Binding Hora}" Width="55"/>
                        <DataGridTextColumn Header="Paciente" Binding="{Binding Paciente}" Width="*" MinWidth="110"/>
                        <DataGridTextColumn Header="Médico" Binding="{Binding Medico}" Width="*"/>
                        <DataGridTextColumn Header="Servicio" Binding="{Binding Servicio}" Width="*"/>
                        <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="0.8*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!--Reserva-->
        <Border Grid.Column="1" Style="{StaticResource tarjeta}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Reservar cita" Style="{StaticResource tituloTarjeta}"/>

                    <TextBlock Text="Paciente (cédula o apellido)" Style="{StaticResource etiqueta}"/>
                    <TextBox Text="{Binding BuscarPaciente, UpdateSourceTrigger=PropertyChanged, Delay=250}" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding PacientesEncontrados}" DisplayMemberPath="Texto" SelectedValuePath="Valor"
                              SelectedValue="{Binding PacienteId}"/>

                    <TextBlock Text="Médico" Style="{StaticResource etiqueta}"/>
                    <ComboBox ItemsSource="{Binding Medicos}" DisplayMemberPath="Texto" SelectedValuePath="Valor"
                              SelectedValue="{Binding MedicoId}"/>

                    <TextBlock Text="Servicio" Style="{StaticResource etiqueta}"/>
                    <ComboBox ItemsSource="{Binding Servicios}" DisplayMemberPath="Texto" SelectedValuePath="Valor"
                              SelectedValue="{Binding ServicioId}"/>

                    <TextBlock Text="Fecha" Style="{StaticResource etiqueta}"/>
                    <DatePicker SelectedDate="{Binding FechaCita}" DisplayDateStart="{Binding FechaMinima, Mode=OneWay}"/>

                    <TextBlock Text="Hora" Style="{StaticResource etiqueta}"/>
                    <ComboBox ItemsSource="{Binding Horarios}" DisplayMemberPath="Texto" SelectedValuePath="Valor"
                              SelectedValue="{Binding Horario}"/>
                    <TextBlock Text="{Binding AvisoHorarios}" Style="{StaticResource textoSecundario}" FontSize="11" Margin="0,5,0,0"/>

                    <Button Content="Reservar" Command="{Binding ReservarCommand}" Style="{StaticResource botonPrimario}"
                            HorizontalAlignment="Left" Margin="0,16,0,0"/>
                    <TextBlock Text="{Binding Mensaje}" Style="{StaticResource mensajeOk}"/>
                    <TextBlock Text="{Binding Error}" Style="{StaticResource mensajeError}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
