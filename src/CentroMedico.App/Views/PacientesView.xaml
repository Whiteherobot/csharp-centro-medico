<UserControl x:Class="CentroMedico.App.Views.PacientesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!--Listado-->
        <Border Grid.Column="0" Style="{StaticResource tarjeta}" Margin="0,0,16,0">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Buscar por cédula o nombre" Style="{StaticResource etiqueta}" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding Filtro, UpdateSourceTrigger=PropertyChanged, Delay=250}" Margin="0,0,12,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Nuevo paciente" Command="{Binding NuevoCommand}"
                            Style="{StaticResource botonPrimario}" VerticalAlignment="Bottom" Margin="0"/>
                </Grid>
                <DataGrid ItemsSource="{Binding Pacientes}" SelectedItem="{Binding Seleccionado}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Cédula" Binding="{Binding Cedula}" Width="92"/>
                        <DataGridTextColumn Header="Apellidos y nombres" Binding="{Binding Nombre}" Width="*" MinWidth="150"/>
                        <DataGridTextColumn Header="Edad" Binding="{Binding EdadTexto}" Width="62"/>
                        <DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono}" Width="92"/>
                        <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="62"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!--Formulario-->
        <Border Grid.Column="1" Style="{StaticResource tarjeta}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{Binding TituloFormulario}" Style="{StaticResource tituloTarjeta}"/>

                    <TextBlock Text="Cédula" Style="{StaticResource etiqueta}"/>
                    <TextBox Text="{Binding Datos.Cedula, UpdateSourceTrigger=PropertyChanged}" MaxLength="10"
                             IsReadOnly="{Binding EsNuevo, Converter={StaticResource Negar}}"/>
                    <TextBlock Text="Nombres" Style="{StaticResource etiqueta}"/>
                    <TextBox Text="{Binding Datos.Nombres, UpdateSourceTrigger=PropertyChanged}" MaxLength="60"/>
                    <TextBlock Text="Apellidos" Style="{StaticResource etiqueta}"/>
                    <TextBox Text="{Binding Datos.Apellidos, UpdateSourceTrigger=PropertyChanged}" MaxLength="60"/>
                    <TextBlock Text="Fecha de nacimiento" Style="{StaticResource etiqueta}"/>
                    <DatePicker SelectedDate="{Binding FechaNacimiento}" DisplayDateEnd="{Binding FechaMaxima, Mode=OneWay}"/>
                    <TextBlock Text="Teléfono" Style="{StaticResource etiqueta}"/>
                    <TextBox Text="{Binding Datos.Telefono, UpdateSourceTrigger=PropertyChanged}" MaxLength="12"/>
                    <TextBlock Text="Correo electrónico (opcional)" Style="{StaticResource etiqueta}"/>
                    <TextBox Text="{Binding Datos.Email, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"/>
                    <TextBlock Text="Dirección" Style="{StaticResource etiqueta}"/>
                    <TextBox Text="{Binding Datos.Direccion, UpdateSourceTrigger=PropertyChanged}" MaxLength="150"/>
                    <CheckBox Content="Paciente activo" IsChecked="{Binding Datos.Activo}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="Guardar" Command="{Binding GuardarCommand}" Style="{StaticResource botonPrimario}"/>
                        <Button Content="Limpiar" Command="{Binding NuevoCommand}" Style="{StaticResource botonSecundario}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Mensaje}" Style="{StaticResource mensajeOk}"/>
                    <TextBlock Text="{Binding Error}" Style="{StaticResource mensajeError}"/>

                    <TextBlock Text="Historial de citas" Style="{StaticResource tituloTarjeta}" Margin="0,22,0,8"
                               Visibility="{Binding EsNuevo, Converter={StaticResource OcultarSiVerdadero}}"/>
                    <ItemsControl ItemsSource="{Binding Historial}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource textoSecundario}" Margin="0,0,0,4">
                                    <Run Text="{Binding Fecha, Mode=OneWay}"/>
                                    <Run Text="{Binding Hora, Mode=OneWay}"/>
                                    <Run Text="·"/>
                                    <Run Text="{Binding Servicio, Mode=OneWay}"/>
                                    <Run Text="·"/>
                                    <Run Text="{Binding Estado, Mode=OneWay}"/>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
