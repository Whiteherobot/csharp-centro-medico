<Window x:Class="CentroMedico.App.Views.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
        xmlns:vm="clr-namespace:CentroMedico.ViewModels;assembly=CentroMedico.ViewModels"
        xmlns:views="clr-namespace:CentroMedico.App.Views"
        xmlns:conv="clr-namespace:CentroMedico.App.Converters"
        Title="Centro Médico" Height="700" Width="1150"
        MinHeight="600" MinWidth="1000"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility"/>
        <conv:IgualConverter x:Key="Igual"/>

        <!--Cada ViewModel se muestra con su vista-->
        <DataTemplate DataType="{x:Type vm:InicioViewModel}"><views:InicioView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:CuentaViewModel}"><views:CuentaView/></DataTemplate>
    </Window.Resources>

    <Border CornerRadius="10" BorderThickness="1">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{StaticResource winBorderColor1}" Offset="0"/>
                <GradientStop Color="{StaticResource winBorderColor2}" Offset="0.5"/>
                <GradientStop Color="{StaticResource winBorderColor3}" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!--Menú lateral-->
            <Border Grid.Column="0" CornerRadius="10,0,0,10">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.7">
                        <GradientStop Color="{StaticResource secondaryBackColor1}" Offset="0"/>
                        <GradientStop Color="{StaticResource secondaryBackColor2}" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="22,25,0,35"
                                MouseLeftButtonDown="Arrastrar" Background="Transparent">
                        <fa:IconImage Icon="HouseMedical" Foreground="{StaticResource color1}" Width="28" Height="28"/>
                        <TextBlock Text="Centro Médico"
                                   Foreground="{StaticResource titleColor2}"
                                   FontSize="18"
                                   FontFamily="Montserrat"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"/>
                    </StackPanel>

                    <!--Usuario y salida-->
                    <StackPanel DockPanel.Dock="Bottom" Margin="22,0,15,20">
                        <TextBlock Text="{Binding NombreUsuario}" Foreground="{StaticResource titleColor2}"
                                   FontFamily="Montserrat" FontSize="12.5" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Rol}" Foreground="{StaticResource plainTextColor1}"
                                   FontFamily="Montserrat" FontSize="11" Margin="0,2,0,10"/>
                        <Button Style="{StaticResource iconButton}" Tag="{StaticResource color4}" Width="Auto"
                                HorizontalAlignment="Left" Command="{Binding CerrarSesionCommand}">
                            <StackPanel Orientation="Horizontal">
                                <fa:IconImage Icon="RightFromBracket" Style="{StaticResource iconButtonIcon}" Width="13" Height="13"/>
                                <TextBlock Text="Cerrar sesión" FontFamily="Montserrat" FontSize="11.5" Margin="8,0,0,0"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Opciones}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Style="{StaticResource menuButton}"
                                             GroupName="menu"
                                             Tag="{StaticResource color1}"
                                             Command="{Binding DataContext.IrACommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                             CommandParameter="{Binding}">
                                    <RadioButton.IsChecked>
                                        <MultiBinding Converter="{StaticResource Igual}" Mode="OneWay">
                                            <Binding/>
                                            <Binding Path="DataContext.OpcionActual" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                        </MultiBinding>
                                    </RadioButton.IsChecked>
                                    <StackPanel Orientation="Horizontal">
                                        <fa:IconImage Icon="{Binding Icono}" Style="{StaticResource menuButtonIcon}" Margin="25,0,15,0"/>
                                        <TextBlock Text="{Binding Titulo}" Style="{StaticResource menuButtonText}"/>
                                    </StackPanel>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <!--Contenido-->
            <Border Grid.Column="1" CornerRadius="0,10,10,0" Background="{StaticResource contentBackColor}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!--Barra de control (se arrastra la ventana desde aquí)-->
                    <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Arrastrar">
                        <Border HorizontalAlignment="Left" Margin="30,8,0,0" Padding="8,2" CornerRadius="4"
                                Background="#FFF1D6"
                                Visibility="{Binding ModoDemo, Converter={StaticResource BooleanToVisibility}}">
                            <TextBlock Text="Modo demo: los datos se pierden al cerrar" FontFamily="Montserrat"
                                       FontSize="10.5" Foreground="#7A5200"/>
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,6,0">
                            <Button Style="{StaticResource controlButton}" Tag="{StaticResource color8}" Click="Minimizar" ToolTip="Minimizar">
                                <fa:IconImage Icon="WindowMinimize" Width="11" Style="{StaticResource controlButtonIcon}"/>
                            </Button>
                            <Button Style="{StaticResource controlButton}" Tag="{StaticResource color6}" Click="Maximizar" ToolTip="Maximizar">
                                <fa:IconImage Icon="Square" Style="{StaticResource controlButtonIcon}"/>
                            </Button>
                            <Button Style="{StaticResource controlButton}" Tag="{StaticResource color4}" Click="Cerrar" ToolTip="Cerrar">
                                <fa:IconImage Icon="Xmark" Style="{StaticResource controlButtonIcon}"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!--Título de la sección-->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="30,6,30,14">
                        <fa:IconImage Icon="{Binding OpcionActual.Icono}" Foreground="{StaticResource accentColor}" Width="20" Height="20"/>
                        <TextBlock Text="{Binding OpcionActual.Titulo}"
                                   Foreground="{StaticResource contentTextColor}"
                                   FontSize="19"
                                   FontFamily="Montserrat"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"/>
                    </StackPanel>

                    <ContentControl Grid.Row="2" Content="{Binding VistaActual}" Margin="30,0,30,25"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
