<UserControl x:Class="CentroMedico.App.Views.PersonalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="330"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource tarjeta}" Margin="0,0,16,0">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Buscar por cédula o nombre" Style="{StaticResource etiqueta}" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding Filtro, UpdateSourceTrigger=PropertyChanged, Delay=250}" Margin="0,0,12,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Nuevo empleado" Command="{Binding NuevoCommand}"
                            Style="{StaticResource botonPrimario}" VerticalAlignment="Bottom" Margin="0"/>
                </Grid>
                <DataGrid ItemsSource="{Binding Empleados}" SelectedItem="{Binding Seleccionado}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Cédula" Binding="{Binding Cedula}" Width="92"/>
                        <DataGridTextColumn Header="Apellidos y nombres" Binding="{Binding Nombre}" Width="1.4*" MinWidth="120"/>
                        <DataGridTextColumn Header="Cargo" Binding="{Binding Cargo}" Width="1.3*"/>
                        <DataGridTextColumn Header="Cuenta" Binding="{Binding CuentaTexto}" Width="*"/>
                        <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="62"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource tarjeta}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{Binding TituloFormulario}" Style="{StaticResource tituloTarjeta}"/>

                    <TextBlock Text="Cédula" Style="{StaticResource etiqueta}"/>
                    <TextBox Text="{Binding Datos.Cedula, UpdateSourceTrigger=PropertyChanged}" MaxLength="10"
                             IsReadOnly="{Binding EsNuevo, Converter={StaticResource Negar}}"/>
                    <TextBlock Text="Nombres" Style="{StaticResource etiqueta}"/>
                    <TextBox Text="{Binding Datos.Nombres, UpdateSourceTrigger=PropertyChanged}" MaxLength="60"/>
                    <TextBlock Text="Apellidos" Style="{StaticResource etiqueta}"/>
                    <TextBox Text="{Binding Datos.Apellidos, UpdateSourceTrigger=PropertyChanged}" MaxLength="60"/>
                    <TextBlock Text="Cargo" Style="{StaticResource etiqueta}"/>
                    <ComboBox ItemsSource="{Binding Cargos}" DisplayMemberPath="Texto" SelectedValuePath="Valor"
                              SelectedValue="{Binding Cargo}"/>
                    <StackPanel Visibility="{Binding EsMedico, Converter={StaticResource BooleanToVisibility}}">
                        <TextBlock Text="Especialidad" Style="{StaticResource etiqueta}"/>
                        <TextBox Text="{Binding Especialidad, UpdateSourceTrigger=PropertyChanged}" MaxLength="60"/>
                    </StackPanel>
                    <TextBlock Text="Teléfono" Style="{StaticResource etiqueta}"/>
                    <TextBox Text="{Binding Datos.Telefono, UpdateSourceTrigger=PropertyChanged}" MaxLength="12"/>
                    <TextBlock Text="Correo electrónico" Style="{StaticResource etiqueta}"/>
                    <TextBox Text="{Binding Datos.Email, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"/>
                    <TextBlock Text="Dirección" Style="{StaticResource etiqueta}"/>
                    <TextBox Text="{Binding Datos.Direccion, UpdateSourceTrigger=PropertyChanged}" MaxLength="150"/>
                    <CheckBox Content="Empleado activo" IsChecked="{Binding Datos.Activo}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="Guardar" Command="{Binding GuardarCommand}" Style="{StaticResource botonPrimario}"/>
                        <Button Content="Limpiar" Command="{Binding NuevoCommand}" Style="{StaticResource botonSecundario}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Mensaje}" Style="{StaticResource mensajeOk}"/>
                    <TextBlock Text="{Binding Error}" Style="{StaticResource mensajeError}"/>

                    <!--Cuenta nueva-->
                    <StackPanel Visibility="{Binding PuedeCrearCuenta, Converter={StaticResource BooleanToVisibility}}" Margin="0,22,0,0">
                        <TextBlock Text="Cuenta de acceso" Style="{StaticResource tituloTarjeta}" Margin="0,0,0,4"/>
                        <TextBlock Text="Este empleado todavía no puede entrar al sistema." Style="{StaticResource textoSecundario}"/>
                        <TextBlock Text="Usuario" Style="{StaticResource etiqueta}"/>
                        <TextBox Text="{Binding NuevoUsuario, UpdateSourceTrigger=PropertyChanged}" MaxLength="20"/>
                        <TextBlock Text="Contraseña inicial" Style="{StaticResource etiqueta}"/>
                        <PasswordBox x:Name="txtClaveNueva" PasswordChanged="Clave_Changed"/>
                        <TextBlock Text="Permiso" Style="{StaticResource etiqueta}"/>
                        <ComboBox ItemsSource="{Binding Roles}" DisplayMemberPath="Texto" SelectedValuePath="Valor"
                                  SelectedValue="{Binding RolCuenta}"/>
                        <Button Content="Crear cuenta" Command="{Binding CrearCuentaCommand}"
                                Style="{StaticResource botonPrimario}" HorizontalAlignment="Left" Margin="0,14,0,0"/>
                    </StackPanel>

                    <!--Cuenta existente-->
                    <StackPanel Visibility="{Binding TieneCuenta, Converter={StaticResource BooleanToVisibility}}" Margin="0,22,0,0">
                        <TextBlock Text="Cuenta de acceso" Style="{StaticResource tituloTarjeta}" Margin="0,0,0,4"/>
                        <TextBlock Style="{StaticResource textoSecundario}">
                            <Run Text="Usuario:"/>
                            <Run Text="{Binding UsuarioActual, Mode=OneWay}" FontWeight="SemiBold"/>
                        </TextBlock>
                        <TextBlock Text="Permiso" Style="{StaticResource etiqueta}"/>
                        <ComboBox ItemsSource="{Binding Roles}" DisplayMemberPath="Texto" SelectedValuePath="Valor"
                                  SelectedValue="{Binding RolCuenta}"/>
                        <CheckBox Content="Cuenta activa" IsChecked="{Binding CuentaActiva}"/>
                        <Button Content="Guardar cuenta" Command="{Binding GuardarCuentaCommand}"
                                Style="{StaticResource botonSecundario}" HorizontalAlignment="Left" Margin="0,12,0,0"/>

                        <TextBlock Text="Restablecer contraseña" Style="{StaticResource etiqueta}" Margin="0,18,0,3"/>
                        <PasswordBox x:Name="txtClaveRestablecer" PasswordChanged="Clave_Changed"/>
                        <Button Content="Restablecer" Command="{Binding RestablecerCommand}"
                                Style="{StaticResource botonSecundario}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
