<UserControl x:Class="CentroMedico.App.Views.ServiciosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource tarjeta}" Margin="0,0,16,0">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock Text="Las consultas y procedimientos médicos tienen tarifa 0 % de IVA; marque 15 % solo para certificados, insumos y similares."
                               Style="{StaticResource textoSecundario}" Margin="0,0,180,0" VerticalAlignment="Center"/>
                    <Button Content="Nuevo servicio" Command="{Binding NuevoCommand}"
                            Style="{StaticResource botonPrimario}" HorizontalAlignment="Right" Margin="0"/>
                </Grid>
                <DataGrid ItemsSource="{Binding Servicios}" SelectedItem="{Binding Seleccionado}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Servicio" Binding="{Binding Nombre}" Width="*"/>
                        <DataGridTextColumn Header="Precio" Binding="{Binding Precio}" Width="100"/>
                        <DataGridTextColumn Header="IVA" Binding="{Binding Iva}" Width="60"/>
                        <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource tarjeta}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="{Binding TituloFormulario}" Style="{StaticResource tituloTarjeta}"/>
                <TextBlock Text="Nombre" Style="{StaticResource etiqueta}"/>
                <TextBox Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" MaxLength="80"/>
                <TextBlock Text="Precio (USD)" Style="{StaticResource etiqueta}"/>
                <TextBox Text="{Binding Precio, UpdateSourceTrigger=PropertyChanged}" MaxLength="10"/>
                <CheckBox Content="Grava IVA 15 %" IsChecked="{Binding GravaIva}"/>
                <CheckBox Content="Servicio activo" IsChecked="{Binding Activo}"/>
                <TextBlock Text="Un servicio inactivo no se puede reservar ni vender, pero se pueden cobrar las citas que ya lo usaban."
                           Style="{StaticResource textoSecundario}" FontSize="11" Margin="0,6,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button Content="Guardar" Command="{Binding GuardarCommand}" Style="{StaticResource botonPrimario}"/>
                    <Button Content="Limpiar" Command="{Binding NuevoCommand}" Style="{StaticResource botonSecundario}"/>
                </StackPanel>
                <TextBlock Text="{Binding Mensaje}" Style="{StaticResource mensajeOk}"/>
                <TextBlock Text="{Binding Error}" Style="{StaticResource mensajeError}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
